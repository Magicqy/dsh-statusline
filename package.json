{
  "name": "dsh-statusline",
  "version": "0.1.2",
  "description": "A bottom status line for DeepSeek Harness: git branch, worktree, working directory, modified / added / untracked / deleted counts and ahead/behind.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "statusline",
    "git"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magicqy/dsh-statusline.git"
  },
  "homepage": "https://github.com/Magicqy/dsh-statusline#readme",
  "bugs": {
    "url": "https://github.com/Magicqy/dsh-statusline/issues"
  },
  "license": "MIT",
  "author": "Yong",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
